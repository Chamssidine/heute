{
  "name": "heute",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "test": "npm test --workspaces --if-present",
    "orchestrator": "npm start -w tools/orchestrator"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "supabase": "2.118.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
